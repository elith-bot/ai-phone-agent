# انسخ هذا الملف إلى .env وأدخل القيم محليًا داخل Termux
TELEGRAM_BOT_TOKEN=
# رقم Telegram الخاص بك فقط، من أمر /id داخل البوت
TELEGRAM_ADMIN_USER_ID=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# اختياري: مزود متوافق مع OpenAI أو خادم محلي
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=llama3.2

# مجلد العمل المسموح للوكيل. في Termux يفضل مجلد مشاريع واضح
WORKSPACE_DIR=/data/data/com.termux/files/home/agent-workspace
# safe أو full؛ full لا يلغي التأكيد على الأوامر الخطرة
AGENT_MODE=safe
MAX_COMMAND_SECONDS=20
